{
  "name": "gitid",
  "version": "0.1.0",
  "description": "gitid 桌面端 — Git 多身份管理器（Electron + Vue3 + AntD）",
  "author": {
    "name": "Xinyi Zhang",
    "email": "42613048+xyztony999@users.noreply.github.com"
  },
  "homepage": "https://github.com/xyztony999/gitid",
  "license": "MIT",
  "private": true,
  "main": "main/index.js",
  "scripts": {
    "sync-core": "node scripts/sync-core.mjs",
    "icon": "node scripts/make-icon.mjs",
    "build:renderer": "vite build",
    "dev": "node dev.mjs",
    "start": "npm run sync-core && npm run build:renderer && electron .",
    "package": "npm run sync-core && npm run build:renderer && electron-builder --linux AppImage && node scripts/make-deb.mjs",
    "dist:linux": "npm run sync-core && npm run build:renderer && electron-builder --linux AppImage deb rpm --x64 --arm64",
    "package:deb": "node scripts/make-deb.mjs",
    "package:win": "npm run sync-core && npm run build:renderer && electron-builder --win nsis --x64 --arm64",
    "test": "node --test"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "ant-design-vue": "^4.2.6",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "io.github.xyztony999.gitid",
    "productName": "gitid",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main/**/*",
      "renderer-dist/**/*",
      "assets/**/*"
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Development"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    }
  }
}
